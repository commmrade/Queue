# Replace with a private random value of at least 32 bytes.
QUEUE_JWT_SECRET=replace-this-with-a-private-random-string-of-at-least-32-bytes

# Use hexadecimal values so DB_PASSWORD is safe inside DATABASE_URL.
DB_PASSWORD=replace-this-with-a-private-database-password
MARIADB_ROOT_PASSWORD=replace-this-with-a-private-root-password
DB_PORT=3307

# Set true when HTTPS terminates in front of the frontend container.
QUEUE_COOKIE_SECURE=false

# Public HTTP port for the Nginx frontend.
FRONTEND_PORT=8080
